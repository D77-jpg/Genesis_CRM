  "schemas": {
    "GlobalSiteC3Product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "globalSiteProductId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "crmProductId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$",
          "nullable": true
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        }
      },
      "required": [
        "globalSiteProductId",
        "crmProductId",
        "name"
      ]
    },
    "GlobalSiteC3Attachment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "fileName": {
          "type": "string",
          "maxLength": 160,
          "minLength": 1
        },
        "downloadUrl": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "mime": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "fileName",
        "downloadUrl",
        "expiresAt",
        "mime",
        "bytes",
        "sha256"
      ]
    },
    "GlobalSiteC3Source": {
