{
  "paths": {
    "/inquiries": {
      "post": {
        "operationId": "createGlobalSiteInquiry",
        "summary": "接收 GlobalSite 询盘并关联待开发客户",
        "description": "先归档并事务保存客户、附件任务和站内负责人通知，再返回201；重放保留首次结果。来源globalsite。只补空字段，不覆盖负责人/阶段或既有外部引用。按邮箱匹配，企业域名唯一匹配时可合并；公共邮箱/歧义不按域名合并。嵌套载荷严格校验；签名附件URL不参与业务内容散列；首次地址供后台下载，重放不刷新地址，过期会显示附件失败；其他业务内容改变返回409。附件失败不撤销询盘。返回相对CRM前端地址。",
        "security": [
          {
            "serviceToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "x-status": "stable",
        "x-required-scope": "inquiries:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GlobalSiteC3Input"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "首次成功或同业务询盘重放；项目和组织隔离",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalSiteC3Response"
                }
              }
            }
          },
          "400": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Field validation failed (existing CRM middleware)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Rejected safely; errors use existing ErrorResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/globalsite-inquiries": {
