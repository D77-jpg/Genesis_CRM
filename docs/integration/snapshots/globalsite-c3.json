            },
            "country": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "name",
            "email",
            "phone",
            "company",
            "country"
          ]
        },
        "products": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/components/schemas/GlobalSiteC3Product"
          }
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000,
          "nullable": true
        },
        "message": {
          "type": "string",
          "maxLength": 8000,
          "minLength": 1
        },
        "attachments": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/components/schemas/GlobalSiteC3Attachment"
          }
        },
        "source": {
          "$ref": "#/components/schemas/GlobalSiteC3Source"
        },
        "spamScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "schemaVersion",
        "sourceSystem",
        "externalInquiryId",
        "site",
        "submittedAt",
        "contact",
        "products",
        "quantity",
        "message",
        "attachments",
        "source",
        "spamScore"
      ]
    },
