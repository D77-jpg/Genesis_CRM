            "medium": {
              "type": "string",
              "maxLength": 200,
              "nullable": true
            },
            "campaign": {
              "type": "string",
              "maxLength": 200,
              "nullable": true
            },
            "term": {
              "type": "string",
              "maxLength": 200,
              "nullable": true
            },
            "content": {
              "type": "string",
              "maxLength": 200,
              "nullable": true
            }
          },
          "required": [
            "source",
            "medium",
            "campaign",
            "term",
            "content"
          ]
        },
        "device": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile",
            "tablet",
            "unknown"
          ]
        },
        "firstVisitAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "pageUrl",
        "referrer",
        "utm",
        "device",
        "firstVisitAt"
      ]
    },
    "GlobalSiteC3Input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "sourceSystem": {
          "type": "string",
          "enum": [
            "globalsite"
          ]
