        ],
        "security": [
          {
            "GlobalSiteC2Session": []
          },
          {
            "GlobalSiteC2UserBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "成功；private,no-store。无密钥、载荷正文、原始URL或响应体进入投递日志。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalSiteC4ConfigState"
                }
              }
            }
          },
          "400": {
            "description": "目标网址不安全或DNS不可用；BAD_REQUEST。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
