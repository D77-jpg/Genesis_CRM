  "metadata": {
    "status": "stable",
    "implemented": true,
    "task": "C4-webhook",
    "description": "仅C3归档且客户来源globalsite的记录。每条关联询盘独立eventId；客户级结果不是精确归因。配置启用后新记录，不历史补推。quotation.sent为首次标记已发送，非SMTP送达。接收端另行实现；原outcomes不变。"
  },
  "securitySchemes": {
    "GlobalSiteC4Signature": {
      "type": "apiKey",
      "in": "header",
      "name": "X-GlobalCRM-Signature",
      "description": "HMAC-SHA256 of timestamp + period + exact raw body using project signing secret. Required timestamp, key ID and event ID headers; receiver verifies time window and durable deduplication."
    }
  }
