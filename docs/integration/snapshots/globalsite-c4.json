  "schemas": {
    "GlobalSiteC4ConfigInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "targetUrl",
        "events",
        "enabled"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "targetUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "公开HTTPS；禁止账号、查询、fragment、自定义端口及内网；保存和每次发送均DNS校验固定IP。"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "lead.status_changed",
              "deal.won",
              "deal.lost",
              "quotation.sent"
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "GlobalSiteC4Config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "targetUrl",
        "events",
        "enabled",
        "revision",
        "generation",
        "keyId",
        "activeSince",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "targetUrl": {
          "type": "string",
          "maxLength": 2000
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "lead.status_changed",
              "deal.won",
              "deal.lost",
              "quotation.sent"
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer"
        },
        "generation": {
          "type": "integer"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "activeSince": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "GlobalSiteC4ConfigState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config"
          ],
          "properties": {
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "projectId",
                "targetUrl",
                "events",
                "enabled",
                "revision",
                "generation",
                "keyId",
                "activeSince",
                "updatedAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{24}$"
                },
                "projectId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{24}$"
                },
                "targetUrl": {
                  "type": "string",
                  "maxLength": 2000
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "lead.status_changed",
                      "deal.won",
                      "deal.lost",
                      "quotation.sent"
                    ]
                  }
                },
                "enabled": {
                  "type": "boolean"
                },
                "revision": {
                  "type": "integer"
                },
                "generation": {
                  "type": "integer"
                },
                "keyId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{24}$"
                },
                "activeSince": {
                  "type": "string",
                  "format": "date-time"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "nullable": true
            }
          }
        }
      }
    },
    "GlobalSiteC4Issued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config",
            "signingSecret"
          ],
          "properties": {
            "config": {
              "$ref": "#/components/schemas/GlobalSiteC4Config"
            },
            "signingSecret": {
              "type": "string",
              "nullable": true,
              "description": "仅首次创建或轮换返回一次；64位十六进制，作为UTF-8文本HMAC密钥。普通保存为null。",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "GlobalSiteC4Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "type",
        "projectId",
        "occurredAt",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "lead.status_changed",
            "deal.won",
            "deal.lost",
            "quotation.sent"
          ]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "customerId",
            "prospectId",
            "crmInquiryId",
            "externalInquiryId",
            "fromStatus",
            "toStatus",
            "quotationId",
            "sourceEventId"
          ],
          "properties": {
            "customerId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "prospectId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$",
              "nullable": true
            },
            "crmInquiryId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "externalInquiryId": {
              "type": "string",
              "maxLength": 128
            },
            "fromStatus": {
              "type": "string",
              "maxLength": 50,
              "nullable": true
            },
            "toStatus": {
              "type": "string",
              "maxLength": 50,
              "nullable": true
            },
            "quotationId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$",
              "nullable": true
            },
            "sourceEventId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$",
              "description": "原始CustomerEvent ID（与outcomes.eventId相同）；quotation.sent使用Quotation ID。用于跨轮询/Webhook业务归并，不替代每条通知eventId的传输去重。"
            }
          }
        }
      }
    },
    "GlobalSiteC4Delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "occurredAt",
        "createdAt",
        "attempts",
        "nextAttemptAt",
        "lastStatusCode",
        "lastErrorCode",
        "generation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "type": {
          "type": "string",
