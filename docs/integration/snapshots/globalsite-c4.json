            "$ref": "#/components/responses/GlobalSiteC2Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "put": {
        "summary": "GlobalSite C4 /webhook put",
        "operationId": "globalSiteC4putwebhook",
        "servers": [
          {
            "url": "/api/projects/integrations"
          }
        ],
        "x-status": "stable",
        "x-implementation-phase": "C4",
        "x-required-roles": [
          "admin",
          "project_admin"
        ],
        "security": [
          {
            "GlobalSiteC2Session": []
          },
          {
            "GlobalSiteC2UserBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/GlobalSiteC2Csrf"
          }
        ],
        "responses": {
          "200": {
            "description": "成功；private,no-store。无密钥、载荷正文、原始URL或响应体进入投递日志。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalSiteC4Issued"
                }
              }
            }
          },
          "400": {
            "description": "目标网址不安全或DNS不可用；BAD_REQUEST。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/GlobalSiteC2Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/GlobalSiteC2Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GlobalSiteC4ConfigInput"
              }
            }
          }
        },
        "callbacks": {
          "globalSiteEvent": {
            "{$request.body#/targetUrl}": {
              "post": {
                "summary": "CRM Worker → GlobalSite（接收端另行实现）",
                "operationId": "globalSiteC4ReceiveEvent",
                "security": [
                  {
                    "GlobalSiteC4Signature": []
                  }
                ],
                "description": "先对原始body验证HMAC及±300秒时间窗，再事务按(projectId,eventId)去重至少30天；重复合法事件返回2xx。签名为v1=hex(HMAC-SHA256(密钥UTF8文本, timestamp+\".\"+原始body字节))。重试每次使用新时间戳，同一eventId/body不变。2xx确认；3xx不跟随；其余重试最多8次。",
                "parameters": [
                  {
                    "name": "X-GlobalCRM-Timestamp",
                    "in": "header",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "pattern": "^[0-9]{10}$"
                    }
                  },
                  {
                    "name": "X-GlobalCRM-Signature",
                    "in": "header",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "pattern": "^v1=[a-f0-9]{64}$"
                    }
                  },
                  {
                    "name": "X-GlobalCRM-Event-Id",
                    "in": "header",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{24}$"
                    }
                  },
                  {
                    "name": "X-GlobalCRM-Key-Id",
                    "in": "header",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{24}$"
                    }
                  }
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/GlobalSiteC4Event"
                      }
                    }
                  }
                },
                "responses": {
                  "204": {
                    "description": "已持久保存或已处理同事件；不得在持久去重前确认。"
                  },
                  "400": {
                    "description": "载荷无效"
                  },
                  "401": {
                    "description": "签名/时间戳无效或过期"
                  },
                  "500": {
                    "description": "暂时失败，将重试"
                  }
                }
              }
            }
          }
        }
      }
    },
