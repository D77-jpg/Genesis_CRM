  "schemas": {
    "GlobalSiteC2Credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scopes",
        "createdBy",
        "createdAt",
        "lastUsedAt",
        "expiresAt",
        "previousValidUntil",
        "status",
        "projectCount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "凭证稳定 ID；非明文或哈希。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "products:read",
              "company:read",
              "playbook:read",
              "knowledge:read",
              "customers:upsert",
              "inquiries:write",
              "outcomes:read",
              "stats:read",
              "quotations:draft",
              "quotations:read"
            ]
          }
        },
        "createdBy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "displayName"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "用户 ID"
            },
            "displayName": {
              "type": "string",
              "description": "当前显示名称"
            }
          },
          "nullable": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUsedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "previousValidUntil": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "revoked"
          ]
        },
        "projectCount": {
          "type": "integer",
          "minimum": 1,
          "description": "此凭证绑定的项目数量；只有全部绑定项目均在管理员权限内才可管理。"
        }
      }
    },
    "GlobalSiteC2Create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scopes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "products:read",
              "company:read",
              "playbook:read",
              "knowledge:read",
              "customers:upsert",
              "inquiries:write",
              "outcomes:read",
              "stats:read",
              "quotations:draft",
              "quotations:read"
            ]
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true,
          "description": "可选到期时间，必须晚于服务端现在；null表示无固定到期。"
        }
      }
    },
    "GlobalSiteC2Rotate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graceSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800,
          "default": 86400,
          "description": "旧令牌宽限秒数；0立即失效；默认24小时，最长7天。脚本默认仍为0。"
        }
      }
    },
    "GlobalSiteC2Issued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credential",
            "token"
          ],
          "properties": {
            "credential": {
              "$ref": "#/components/schemas/GlobalSiteC2Credential"
            },
            "token": {
              "type": "string",
              "pattern": "^gci_[a-f0-9]{48}$",
              "description": "仅本次创建/轮换响应提供，必须no-store，不得持久化、记录或重放取回。"
            }
          }
        }
      }
    },
    "GlobalSiteC2Revoked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "$ref": "#/components/schemas/GlobalSiteC2Credential"
        }
      }
    },
    "GlobalSiteC2Log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "method",
        "route",
        "statusCode",
        "latencyMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "日志 ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "description": "HTTP 方法"
        },
        "route": {
          "type": "string",
          "description": "路由模板；无查询串"
        },
        "statusCode": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "GlobalSiteC2Credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "page",
            "limit",
            "total"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/GlobalSiteC2Credential"
              }
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "GlobalSiteC2Logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "page",
            "limit",
            "total"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/GlobalSiteC2Log"
              }
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "GlobalSiteC2Settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scopes",
            "globalsitePreset",
            "quota"
          ],
          "properties": {
            "scopes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "available"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "products:read",
                      "company:read",
                      "playbook:read",
                      "knowledge:read",
                      "customers:upsert",
                      "inquiries:write",
                      "outcomes:read",
                      "stats:read",
                      "quotations:draft",
                      "quotations:read"
                    ]
                  },
                  "available": {
                    "type": "boolean"
                  }
                }
              }
            },
            "globalsitePreset": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "products:read",
                  "company:read",
                  "playbook:read",
                  "knowledge:read",
                  "customers:upsert",
                  "inquiries:write",
                  "outcomes:read",
                  "stats:read",
                  "quotations:draft",
                  "quotations:read"
                ]
              }
            },
            "quota": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "limit",
                "used"
              ],
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1
                },
                "used": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "parameters": {
    "GlobalSiteC2Page": {
      "name": "page",
      "in": "query",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 1
      }
    },
    "GlobalSiteC2Limit": {
      "name": "limit",
      "in": "query",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      }
    },
    "GlobalSiteC2CredentialId": {
      "name": "credentialId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$"
      }
    },
    "GlobalSiteC2Csrf": {
      "name": "X-CSRF-Token",
      "in": "header",
      "required": false,
      "description": "Cookie会话写请求必填且与会话Cookie匹配；旧Bearer用户JWT方式保持兼容。",
      "schema": {
        "type": "string"
      }
    },
    "GlobalSiteC2LogCredential": {
      "name": "credentialId",
      "in": "query",
      "required": false,
      "schema": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$"
      }
    }
  },
  "responses": {
    "GlobalSiteC2Forbidden": {
      "description": "用户不是项目管理员/管理员，或CSRF校验失败。",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        }
      }
    },
    "GlobalSiteC2Conflict": {
      "description": "达到凭证数量上限(details.reason=CREDENTIAL_LIMIT)，或并发轮换/正在宽限期(details.reason=ROTATION_IN_PROGRESS)。不自动重试；用户确认后重操作。",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        }
      }
    }
  },
  "securitySchemes": {
    "GlobalSiteC2Session": {
      "type": "apiKey",
      "in": "cookie",
      "name": "cdlm_access",
      "description": "CRM用户Cookie会话；不是服务凭证。"
    },
    "GlobalSiteC2UserBearer": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT",
      "description": "兼容现有用户JWT；不是gci_服务凭证。"
    }
  }
}
