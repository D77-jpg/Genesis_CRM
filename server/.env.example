# ==========================================================================
# Customer Dev Letter Manager - 后端环境变量示例
# 复制为 .env 后按需修改：  copy .env.example .env
# ==========================================================================

# ---------- 运行时 ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
# 前端地址，多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 是否允许 RFC1918/本机局域网来源；仍只放行下方列出的前端端口
CORS_ALLOW_PRIVATE_NETWORK=true
CORS_LAN_PORTS=5173,4173

# ---------- MongoDB ----------
# 本地 MongoDB Community 默认地址
MONGODB_URI=mongodb://127.0.0.1:27017/cdlm
# 如使用用户名密码： mongodb://user:pass@127.0.0.1:27017/cdlm?authSource=admin

# ---------- 鉴权（mock 登录）----------
JWT_SECRET=
JWT_EXPIRES_IN=7d
# 默认管理员账号（首次启动会自动写入 users 集合）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Genesis Admin

# ---------- 邮件发送 ----------
# mock = 不真实发信，只在数据库记录发送结果（默认，开箱即用）
# smtp = 使用真实 SMTP 服务器发送
# 阿里国际站企业邮箱示例：smtp.alibaba.com:25，SSL 关，通过 STARTTLS 加密；SMTP_USER/SMTP_PASS 填邮箱帐号与授权码
MAIL_TRANSPORT=mock
MAIL_FROM=Genesis (Xiamen) Bags Co., Ltd. <sales@genesisgroup.cn>
# 多项目邮箱配置。键对应项目 mailProfileKey；未配置的非默认项目使用 mock 且不启用 IMAP。
# PROJECT_MAIL_CONFIGS_JSON={"ironhue":{"transport":"smtp","mailFrom":"IRONHUE <sales@example.com>","smtp":{"host":"smtp.example.com","port":587,"secure":false,"requireTLS":true,"user":"sales@example.com","pass":"authorization-code"},"imap":{"enabled":true,"host":"imap.example.com","port":993,"secure":true,"user":"sales@example.com","password":"authorization-code","mailbox":"INBOX"}}}
PROJECT_MAIL_CONFIGS_JSON={}
# 必须是收件人的邮件客户端可访问的 HTTPS 地址（本地开发可用 http://localhost:5000）
TRACKING_BASE_URL=http://localhost:5000
SMTP_HOST=smtp.alibaba.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true

# ---------- V2.1 后台收件 ----------
# 默认关闭；填写完整并确认服务器支持 STARTTLS 后启用。
# 阿里外贸邮当前推荐 993 隐式 SSL；143 仅在服务器明确提供 STARTTLS 时使用。
IMAP_ENABLED=false
IMAP_HOST=imap.alibaba.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SYNC_INTERVAL_MS=60000
IMAP_MAX_MESSAGE_SIZE=26214400

# MongoDB 持久化发送队列，无需 Redis
MAIL_WORKER_INTERVAL_MS=2000
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=30000
# 邮件附件复用 UPLOAD_DIR 下的 mail 子目录。未配置 UPLOAD_DIR 时使用 server/uploads。
MAX_ATTACHMENT_SIZE=15728640

# ---------- Agent V1.0–V1.4 ----------
# mock = 本地可用且不会访问外部服务；openai = 服务端调用 Responses API
AI_PROVIDER=mock
# 仅保存在 server/.env，绝不要写入 web/.env 或提交到 Git
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_TOOL_CALLS=6
# 输入预算与每用户每日保护额度（按项目隔离）
AI_MAX_INPUT_CHARS=60000
AI_DAILY_RUN_LIMIT=100
AI_DAILY_TOKEN_LIMIT=500000
AI_MAX_OUTPUT_TOKENS=3000
# 管理员诊断页成本估算：填写当前模型每百万 token 的美元价格；0 表示未配置
AI_INPUT_USD_PER_1M_TOKENS=0
AI_OUTPUT_USD_PER_1M_TOKENS=0

# ---------- 业务默认值（开发信占位符 / 签名）----------
COMPANY_NAME=Genesis (Xiamen) Bags Co., Ltd.
COMPANY_WEBSITE=https://www.genesisbags.com
COMPANY_MOQ=100 pcs
SENDER_NAME=Genesis Sales Team
