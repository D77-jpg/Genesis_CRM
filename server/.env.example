# ==========================================================================
# Customer Dev Letter Manager - 后端环境变量示例
# 复制为 .env 后按需修改：  copy .env.example .env
# ==========================================================================

# ---------- 运行时 ----------
NODE_ENV=development
PORT=5000
# 前端地址，多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------- MongoDB ----------
# 本地 MongoDB Community 默认地址
MONGODB_URI=mongodb://127.0.0.1:27017/cdlm
# 如使用用户名密码： mongodb://user:pass@127.0.0.1:27017/cdlm?authSource=admin

# ---------- 鉴权（mock 登录）----------
JWT_SECRET=please-change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
# 默认管理员账号（首次启动会自动写入 users 集合）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
ADMIN_DISPLAY_NAME=Genesis Admin

# ---------- 邮件发送 ----------
# mock = 不真实发信，只在数据库记录发送结果（默认，开箱即用）
# smtp = 使用真实 SMTP 服务器发送
# 阿里国际站企业邮箱示例：smtp.alibaba.com:25，SSL 关、STARTTLS  opportunistic 升级；SMTP_USER/SMTP_PASS 填邮箱帐号与密码
MAIL_TRANSPORT=mock
MAIL_FROM=Genesis (Xiamen) Bags Co., Ltd. <sales@genesisgroup.cn>
SMTP_HOST=smtp.alibaba.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- 业务默认值（开发信占位符 / 签名）----------
COMPANY_NAME=Genesis (Xiamen) Bags Co., Ltd.
COMPANY_WEBSITE=https://www.genesisbags.com
COMPANY_MOQ=100 pcs
SENDER_NAME=Genesis Sales Team
