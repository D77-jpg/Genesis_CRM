{
  "name": "cdlm-server",
  "version": "2.6.0",
  "private": true,
  "description": "Customer Dev Letter Manager - REST API (Express + MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch-path=src --require ./scripts/os-user-info.cjs --import tsx src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke:xlsx": "node --import tsx scripts/smoke-xlsx.ts",
    "seed": "node --require ./scripts/os-user-info.cjs --import tsx src/scripts/seed.ts",
    "reset": "node --require ./scripts/os-user-info.cjs --import tsx src/scripts/seed.ts --reset",
    "test:name": "node --require ./tests/os-user-info.cjs --import tsx --test tests/company-name.test.ts",
    "test:dedupe": "node --require ./tests/os-user-info.cjs --import tsx --test tests/customer-duplicate.test.ts",
    "test:lead-import": "node --require ./tests/os-user-info.cjs --import tsx --test tests/prospect-import.test.ts",
    "test:import": "node --require ./tests/os-user-info.cjs --import tsx --test tests/customer-import.test.ts",
    "test:country": "node --require ./tests/os-user-info.cjs --import tsx --test tests/country-normalize.test.ts",
    "test:mail": "node --require ./tests/os-user-info.cjs --import tsx --test tests/mail-center.test.ts tests/pop3-client.test.ts tests/letter-signature.test.ts tests/letter-validator.test.ts",
    "test:template-feedback": "node --require ./tests/os-user-info.cjs --import tsx --test tests/template-feedback.test.ts",
    "test:scratchpad": "node --require ./tests/os-user-info.cjs --import tsx --test tests/scratchpad.test.ts",
    "test:knowledge": "node --require ./tests/os-user-info.cjs --import tsx --test tests/project-knowledge.test.ts",
    "test:prospecting": "node --require ./tests/os-user-info.cjs --import tsx --test tests/prospecting.test.ts tests/prospecting-profiles.test.ts",
    "test:agent": "node --require ./tests/os-user-info.cjs --import tsx --test tests/agent.test.ts",
    "test:ai-settings": "node --require ./tests/os-user-info.cjs --import tsx --test tests/ai-settings.test.ts",
    "test:security": "node --require ./tests/os-user-info.cjs --import tsx --test tests/security-hardening.test.ts",
    "test:health": "node --require ./tests/os-user-info.cjs --import tsx --test tests/health-readiness.test.ts",
    "test:integration": "node --require ./tests/os-user-info.cjs --import tsx --test tests/integration.test.ts",
    "integration:credential": "node --require ./scripts/os-user-info.cjs --import tsx src/scripts/integration-credential.ts",
    "test:fixture": "node tests/start-fixture.cjs",
    "eval:knowledge:validate": "node --require ./tests/os-user-info.cjs --import tsx evaluation/knowledge/schema.ts",
    "eval:knowledge:baseline": "node --require ./tests/os-user-info.cjs --import tsx evaluation/knowledge/baseline.ts",
    "test:knowledge-evaluation": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-evaluation.test.ts",
    "test:knowledge-ingestion": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-ingestion.test.ts",
    "test:knowledge-index": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-index.test.ts",
    "test:knowledge-retrieval": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-retrieval.test.ts",
    "eval:knowledge:retrieval": "node --require ./tests/os-user-info.cjs --import tsx evaluation/knowledge/retrieval.ts",
    "test:knowledge-facts": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-facts.test.ts tests/knowledge-verifier-boundaries.test.ts",
    "eval:knowledge:facts": "node --require ./tests/os-user-info.cjs --import tsx evaluation/knowledge/fact-evaluation.ts",
    "test:knowledge-governance": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-governance.test.ts",
    "test:knowledge-training": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-training.test.ts",
    "test:knowledge-workflow": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-workflow.test.ts",
    "test:knowledge-operations": "node --require ./tests/os-user-info.cjs --import tsx --test tests/knowledge-operations.test.ts",
    "eval:knowledge:operations": "node --require ./tests/os-user-info.cjs --import tsx evaluation/knowledge/operations.ts",
    "knowledge:maintenance": "node --require ./scripts/os-user-info.cjs --import tsx src/scripts/knowledge-maintenance.ts",
    "test:website-research": "node --require ./tests/os-user-info.cjs --import tsx --test tests/website-public-web.test.ts tests/website-research.test.ts",
    "dev:workspace": "node --require ./scripts/os-user-info.cjs --import tsx src/local-workspace.ts"
  },
  "dependencies": {
    "@embedpdf/fonts-sc": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "htmlparser2": "10.1.0",
    "imapflow": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.23",
    "mammoth": "1.13.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.1",
    "pdf-parse": "2.4.5",
    "pdfkit": "^0.20.2",
    "sanitize-html": "^2.17.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "mongodb-memory-server": "^11.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": { "body-parser": "^1.20.9", "qs": "^6.16.0",
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
