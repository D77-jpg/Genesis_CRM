# Staging environment. Copy to .env.staging OUTSIDE version control.
# This is a production-like rehearsal stack with its own database, secrets and volumes.
# Never point staging at the production database or reuse production secrets.
APP_ENV=staging
MONGO_ROOT_USERNAME=REPLACE_WITH_STAGING_MONGO_ADMIN_USER
MONGO_ROOT_PASSWORD=REPLACE_WITH_STAGING_MONGO_ADMIN_PASSWORD
MONGODB_URI=mongodb://REPLACE_WITH_URI_ENCODED_STAGING_USER:REPLACE_WITH_URI_ENCODED_STAGING_PASSWORD@mongo:27017/cdlm_staging?authSource=admin
JWT_SECRET=REPLACE_WITH_UNIQUE_STAGING_JWT_SECRET_32_PLUS_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
COOKIE_SECURE=true
ADMIN_USERNAME=staging-admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STAGING_ADMIN_PASSWORD
ADMIN_EMAIL=
MAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_STAGING_MAIL_KEY_32_PLUS_CHARACTERS
TRACKING_BASE_URL=https://staging-crm.example.com
PUBLIC_BASE_URL=https://staging-crm.example.com
APP_BASE_URL=https://staging-crm.example.com
CORS_ORIGIN=https://staging-crm.example.com
VITE_API_BASE_URL=/api
VITE_APP_TITLE=GlobalCRM Staging
# Separate host port from production; still bind to loopback behind an operator-managed TLS ingress.
GLOBALCRM_HTTP_PORT=8081
# Use a staging-only SMTP sandbox, or mock when testing UI flows without delivery.
MAIL_TRANSPORT=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true
IMAP_ENABLED=false

DEFAULT_ORGANIZATION_NAME=Staging Organization
DEFAULT_ORGANIZATION_SLUG=staging
RUN_BACKGROUND_JOBS=false
WORKER_HEALTH_PORT=5100
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
METRICS_ENABLED=true
# Staging load tests may raise this only for the isolated run; restore 600 afterwards.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
