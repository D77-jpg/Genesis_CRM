# ==========================================================================
# Customer Dev Letter Manager - 前端环境变量示例
# 复制为 .env 后按需修改：  copy .env.example .env
# ==========================================================================

# API 基础路径。
# 默认 /api，由 vite.config.ts 的 proxy 转发到后端，天然规避 CORS。
# 如果前端与后端不同域部署，改成完整地址，例如 http://localhost:5000/api
VITE_API_BASE_URL=/api

# Vite dev / preview server 的代理目标（仅本地开发生效）
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# 应用标题（显示在侧边栏顶部）
VITE_APP_TITLE=客户开发信管理工具

# JWT 在 localStorage 中的存储键名
VITE_TOKEN_STORAGE_KEY=cdlm-token
