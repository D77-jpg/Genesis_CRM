# 冻结契约文件必须逐字节稳定（CI 校验 SHA-256），禁止 Windows runner 行尾转换
docs/integration/*.openapi.yaml text eol=lf

# S0 frozen fixtures and evaluator/model locks must keep byte-stable LF.
server/evaluation/knowledge/** text eol=lf
docs/knowledge-s0-results/*.json text eol=lf
docs/knowledge-agent-roadmap.md text eol=lf

# Parser identity and Python sources stay byte-stable across platforms.
server/tests/fixtures/knowledge-s2/* text eol=lf
server/semantic/* text eol=lf
server/parsers/* text eol=lf
server/tests/fixtures/knowledge-s1/* text eol=lf

# S4 first-measurement evidence must remain byte-stable on Windows and Linux.
docs/knowledge-s4-results/*.json text eol=lf

# S5 acceptance snapshots keep reproducible LF bytes.
docs/knowledge-s5-results/*.json text eol=lf
