# Copy to .env.production OUTSIDE version control. Never use placeholder values to start production.
# Generate unique random secrets in a secret manager; URI-encode Mongo username/password in MONGODB_URI.
APP_ENV=production
MONGO_ROOT_USERNAME=REPLACE_WITH_PRIVATE_MONGO_ADMIN_USER
MONGO_ROOT_PASSWORD=REPLACE_WITH_PRIVATE_MONGO_ADMIN_PASSWORD
MONGODB_URI=mongodb://REPLACE_WITH_URI_ENCODED_MONGO_USER:REPLACE_WITH_URI_ENCODED_MONGO_PASSWORD@mongo:27017/cdlm?authSource=admin
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Production is expected to terminate TLS; Secure cookies are required.
COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_16_PLUS_CHARACTER_PASSWORD
# Optional: bind an email to the bootstrap administrator for password reset/2FA.
ADMIN_EMAIL=
MAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_RANDOM_32_PLUS_CHARACTER_SECRET
TRACKING_BASE_URL=https://crm.example.com
PUBLIC_BASE_URL=https://crm.example.com
APP_BASE_URL=https://crm.example.com
CORS_ORIGIN=https://crm.example.com
# Baked into web bundle during build; /api is same-origin via Nginx (recommended).
VITE_API_BASE_URL=/api
VITE_APP_TITLE=GlobalCRM
# Loopback-only host port for an operator-managed HTTPS ingress.
GLOBALCRM_HTTP_PORT=8080
MAIL_TRANSPORT=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_REQUIRE_TLS=true
IMAP_ENABLED=false

# P2 tenant / worker / storage / metrics
DEFAULT_ORGANIZATION_NAME=Default Organization
DEFAULT_ORGANIZATION_SLUG=default
# Compose overrides API to false and worker to true; keep API false in multi-process production.
RUN_BACKGROUND_JOBS=false
WORKER_HEALTH_PORT=5100
# local is single-host only; use s3 for multi-replica API.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
METRICS_ENABLED=true
# Safety valve for incident response and isolated load tests. Keep 600 in production.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600

# Optional GlobalSite attachment download origin allowlist (exact origins, comma-separated).
GLOBALSITE_ATTACHMENT_ORIGINS=
# Development/test loopback only; ignored in production.
GLOBALSITE_ALLOW_LOCAL=false

# Optional CRM identity provider (C5); disabled without a valid dedicated keyring.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_PUBLIC_WEB_ORIGIN=
OIDC_SIGNING_KEYRING_PATH=
OIDC_ACTIVE_KEY_ID=
# Exact loopback development clients only; never enabled in production.
OIDC_ALLOW_LOOPBACK=false
